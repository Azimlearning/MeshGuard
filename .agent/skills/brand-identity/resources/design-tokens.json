{
    "meta": {
        "brand_name": "Resilience Radar",
        "description": "Premium design tokens for UKM Data Challenge 5.0, inspired by Superpowers and Antigravity-Awesome-Skills."
    },
    "colors": {
        "sdg3": {
            "DEFAULT": "#4C9F38",
            "hover": "#3D852D",
            "foreground": "#FFFFFF",
            "label": "Good Health"
        },
        "sdg8": {
            "DEFAULT": "#A21942",
            "hover": "#8B1538",
            "foreground": "#FFFFFF",
            "label": "Decent Work"
        },
        "ukm": {
            "blue": "#003399",
            "red": "#CC0000",
            "yellow": "#FFCC00"
        },
        "surface": {
            "DEFAULT": "#FFFFFF",
            "glass": "rgba(255, 255, 255, 0.7)",
            "dark_glass": "rgba(17, 24, 39, 0.7)"
        },
        "background": {
            "DEFAULT": "#F9FAFB",
            "dark": "#0B0F19"
        }
    },
    "effects": {
        "shadow": {
            "soft": "0 4px 20px -2px rgba(0, 0, 0, 0.05)",
            "glow_sdg3": "0 0 20px rgba(76, 159, 56, 0.2)",
            "glow_sdg8": "0 0 20px rgba(162, 25, 66, 0.2)"
        },
        "blur": {
            "glass": "12px",
            "overlay": "4px"
        }
    },
    "animation": {
        "durations": {
            "fast": "150ms",
            "normal": "300ms",
            "slow": "500ms"
        },
        "curves": {
            "premium": "cubic-bezier(0.16, 1, 0.3, 1)"
        }
    },
    "typography": {
        "headings": "Inter",
        "body": "Roboto",
        "scale": {
            "h1": "2.25rem",
            "h2": "1.875rem",
            "h3": "1.5rem",
            "base": "1rem"
        }
    },
    "layout": {
        "radius": {
            "card": "1rem",
            "button": "0.5rem",
            "pill": "9999px"
        },
        "spacing": "4px"
    }
}